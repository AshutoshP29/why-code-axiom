# Copy to .env and fill in. Never commit .env.

# Neo4j AuraDB (from the Aura console credentials file)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=
LLM_MAX_CALLS=
# Optional local model via Ollama (e.g. qwen2.5:7b-instruct); leave empty to disable.
LOCAL_LLM_MODEL=
# Optional: defaults are http://127.0.0.1:11434 and gemini,groq,local
LOCAL_LLM_URL=
LLM_PROVIDERS=

# GitHub REST API
GITHUB_TOKEN=

# Local Postgres (must match docker-compose.yml)
POSTGRES_DSN=
